#!/bin/sh
# Nightly backup of Where to Eat (installed by setup-lunch.sh). Runs from /etc/periodic/daily next to
# ct210-backup and roasted-backup, using the same settings, folder and log, so all CT 210 apps land together:
#   $LOCAL_DIR/<date>/lunch-lunch.db.gz          (kept KEEP_DAYS days)
#   $BACKUP_TARGET/db/<date>/...  + $BACKUP_TARGET/files/lunch/photos/   (if BACKUP_TARGET is set)
# Config: /etc/conf.d/ct210-ops     Log: /var/log/ct210-ops.log
set -u
[ -f /etc/conf.d/ct210-ops ] && . /etc/conf.d/ct210-ops
LOCAL_DIR=${LOCAL_DIR:-/var/backups/ct210}
KEEP_DAYS=${KEEP_DAYS:-14}
BACKUP_TARGET=${BACKUP_TARGET:-}
STAMP=$(date +%Y-%m-%d)
LOG=/var/log/ct210-ops.log
DB=/var/lib/lunch/lunch.db
log() { echo "$(date '+%F %T') lunch-backup: $*" >> "$LOG"; }

fail=0
mkdir -p "$LOCAL_DIR/$STAMP"
out="$LOCAL_DIR/$STAMP/lunch-lunch.db"
if [ -f "$DB" ]; then
  if sqlite3 "$DB" ".backup '$out'" && [ "$(sqlite3 "$out" 'PRAGMA integrity_check;')" = "ok" ]; then
    gzip -f "$out"
    log "ok lunch/lunch.db ($(du -h "$out.gz" | cut -f1))"
  else
    log "FAILED lunch/lunch.db"; fail=1
  fi
fi
find "$LOCAL_DIR" -mindepth 1 -maxdepth 1 -type d -mtime +"$KEEP_DAYS" -exec rm -rf {} + 2>/dev/null

if [ -n "$BACKUP_TARGET" ]; then
  if [ -d "$BACKUP_TARGET" ] && [ -w "$BACKUP_TARGET" ]; then
    mkdir -p "$BACKUP_TARGET/db/$STAMP" "$BACKUP_TARGET/files/lunch/photos"
    [ -f "$out.gz" ] && { cp -a "$out.gz" "$BACKUP_TARGET/db/$STAMP/" || fail=1; }
    # photos are write-once: copy new files only (staged tmp- uploads are skipped by being short-lived)
    cp -au /var/lib/lunch/photos/. "$BACKUP_TARGET/files/lunch/photos/" || fail=1
    log "lunch copied to $BACKUP_TARGET"
  else
    log "FAILED: BACKUP_TARGET $BACKUP_TARGET is not a writable directory (is it mounted?)"; fail=1
  fi
fi

if [ "$fail" != 0 ] && [ -x /usr/local/bin/ct210-notify ]; then
  /usr/local/bin/ct210-notify "Lunch backup" down "Last night's Where to Eat backup had a problem. See /var/log/ct210-ops.log."
fi
exit $fail
